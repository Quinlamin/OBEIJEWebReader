@page "/"
@using System.IO;
@using System.IO.Compression;
@using EpubSharp
@using HtmlAgilityPack;
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.SignalR
@rendermode InteractiveServer
@inject IJSRuntime JS
<PageTitle>@BookTitle</PageTitle>

<div class="reader">

    <!-- Header -->
    <header class="reader-header">

        <a href="/" class="back-button">
            ← Library
        </a>

        <div class="book-title">
            <strong>@BookTitle</strong>
            <span>@ChapterTitle</span>
        </div>

    </header>


    <!-- Chapter selector -->
    <div class="chapter-bar">

        <select value="@CurrentChapter" @onchange="DisplayChapter">
            @{index = 0;}
            @foreach (EpubChapter chapter in chapters)
            {
                <option value=@index>
                    @chapter.Title
                </option>
                index++;
            }
        </select>

    </div>


    <!-- EPUB content -->
    <main class="reader-content">

        @((MarkupString)ChapterHtml)

    </main>


    <!-- Navigation -->
    <footer class="reader-navigation">

        <button @onclick="PreviousChapter">
            ← Previous
        </button>

        <span>
            @(CurrentChapter+1) / @TotalChapters
        </span>

        <button @onclick="NextChapter">
            Next →
        </button>

    </footer>

</div>

@code {
    private int index = 0;
    private string epubUrl = "/home/lac/Calibre Library/BEAUCHAMP, WILLIAM/hathaway vol01 (3)/hathaway vol01 - BEAUCHAMP, WILLIAM.epub";
    private string eepubUrl = "/home/lac/Downloads/yes.epub";
    private string ChapterHtml {get;set;}
    private int chapterID {get;set;}

    EpubBook book {get;set;}

    List<EpubChapter> chapters {get;set;}
    List<EpubChapter> parts {get;set;}
    private string navbuttons {get;set;}
    private bool hasChapters {get;set;}
    private string BookTitle {get;set;}
    private string ChapterTitle {get;set;}
    private int TotalChapters {get;set;}
    private int CurrentChapter = 0;

    async void NextChapter()
    {
        if(CurrentChapter < TotalChapters)
        {
            CurrentChapter++;
            DisplayChapter();
                await JS.InvokeVoidAsync("scrollToTop");

        }
        
    }
    async void PreviousChapter()
    {
        if(CurrentChapter > 1)
        {
            CurrentChapter--;
            DisplayChapter();
            await JS.InvokeVoidAsync("scrollToTop");

        }
        
        
    }
    protected override async Task OnInitializedAsync()
    {

        book = EpubReader.Read(epubUrl);
        BookTitle = book.Title;
        
        chapters = book.TableOfContents;
        
        if(book.TableOfContents.Count > 0)
        {
            hasChapters = true;
        }
        else
        {
            hasChapters = false;
        }
        parts = new List<EpubChapter>();
        foreach(EpubChapter chapter in chapters)
        {
            parts.Add(chapter);
            
            if(chapter.SubChapters != null)
            {
                parts.AddRange(chapter.SubChapters);
            }
        }
        
        TotalChapters = chapters.Count;
        DisplayChapter();
    }
    
    private void DisplayChapter()
    {

        try{
            ChapterTitle = chapters[CurrentChapter].Title;
            ICollection<EpubByteFile> images = book.Resources.Images;
            if (!hasChapters)
            {
                return;
            }
            using (ZipArchive archive = ZipFile.OpenRead(epubUrl))
            {

                string html = "";
                
                foreach(ZipArchiveEntry entry in archive.Entries)
                {
                    
                    if(entry.Name == chapters[CurrentChapter].FileName)
                    {
                        
                        using (StreamReader reader = new StreamReader(entry.Open()))
                        {
                            html = reader.ReadToEnd();

                        }
                    }

                }
                HtmlDocument document = new HtmlDocument();
                document.LoadHtml(html);
                var imgNodes = document.DocumentNode.SelectNodes("//img");
                if(imgNodes != null)
                {
                    foreach(HtmlNode img in imgNodes)
                    {
                        string currentSrc = img.GetAttributeValue("src","");
                        EpubByteFile selectedImage = null;
                        foreach(EpubByteFile image in images)
                        {
                            if(image.FileName == currentSrc)
                            {
                                selectedImage = image;
                                break;
                            }
                        }
                        if(selectedImage != null)
                        {
                            img.SetAttributeValue("src",$"data:image/{Path.GetExtension(selectedImage.FileName).TrimStart('.')};base64,{Convert.ToBase64String(selectedImage.Content)}");
                        }

                    }
                }
                ChapterHtml = document.DocumentNode.InnerHtml;

            }
        }
        catch
        {
            Console.WriteLine("problem");
        }
    }

    
}